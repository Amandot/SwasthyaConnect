###########################################################
#  Arogo Backend Environment Configuration Example
###########################################################

# Server Configuration
PORT=5001
NODE_ENV=production

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=https://your-frontend-domain.com

# Firebase Admin SDK (service account)
# Map these from your service account JSON
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR-PRIVATE-KEY\n-----END PRIVATE KEY-----\n"

# JWT secret for signing/verifying tokens
JWT_SECRET=your-secure-jwt-secret

# Google Gemini AI (for symptom checker)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_REQUEST_TIMEOUT_MS=12000

PARSE_API_KEY=your_parse_api_key_here
PARSE_API_KEY_PHARMEASY=your_pharmeasy_parse_api_key_here
PARSE_API_KEY_APOLLO=your_apollo_parse_api_key_here
PARSE_API_KEY_1MG=your_1mg_parse_api_key_here
PARSE_MEDICINE_TIMEOUT_MS=12000
PARSE_MEDICINE_OPENAPI_TIMEOUT_MS=8000
PARSE_MEDICINE_OPENAPI_CACHE_TTL_MS=300000
PARSE_MEDICINE_MAX_RESULTS=20

# Supabase PostgreSQL Configuration
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
